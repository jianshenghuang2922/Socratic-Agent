# Socratic-Agent 环境变量示例
# 复制为 .env 并按需填写；修改后重启开发服务器。

# 会话状态保存在进程内存里（src/server/store.ts），当前不需要任何外部数据库。
LLM_MODEL=deepseek/deepseek-chat
# 主模型被限流（429）或故障时依次降级的备用模型，逗号分隔；留空则关闭降级。
# 上游 provider 的 429 是常态，建议至少配两个。
# ⚠️ 这里必须填**你的账号真的能调用**的模型：配了没额度的付费模型，
#    降级链等于不存在（每次都会 402），主模型一失败就直接失败。
#    免费模型以 :free 结尾，例如 OpenRouter 上的
#    nvidia/nemotron-3-super-120b-a12b:free / qwen/qwen3.8-27b:free。
LLM_FALLBACK_MODELS=deepseek/deepseek-chat-v3.1,qwen/qwen3-max,z-ai/glm-4.6
# 单个模型的尝试次数（含首次），失败按指数退避重试
LLM_MAX_RETRIES=3
# 单次调用的输出 token 预算。⚠️ 推理模型（deepseek-r1 / qwen3 等）的
# **推理过程同样计入这个预算**：给 2500 时推理没结束预算就没了，
# 正文为空或 JSON 被截成半截（前端报「模型没有返回合法的 JSON」）。
# 8000 实测可覆盖常见推理模型。付费网关按 max_tokens 预扣额度，余额小可调小。
LLM_MAX_TOKENS=8000
# 输出被截断时逐次翻倍的上限（兜底，一般不用改）
LLM_MAX_TOKENS_CEILING=16000
EMBEDDING_MODEL=text-embedding-3-small

# ---------- 免费试用额度 ----------
# 公开部署挂一个共享 Key 且不限量 = 几分钟被刷爆；但一进门就要用户填 Key，
# 等于要他拿信用卡换空气 —— 他还没看到任何价值。折中：先给一小份免费额度。
#
# 计数口径是「一次会调用模型的动作」（提问 / 出题 / 提示 / 简答题判分），
# 与内部重试次数无关：一次提问内部可能重试 3 次、换 2 个模型，对用户仍是「一次」。
# 选择题判分是纯服务端比对，不调模型，**不占额度**。
# 调用失败（上游 429 / 超时）会**退还**额度 —— 免费模型限流是常态，
# 不退的话用户会被白扣到零，体验比没有额度更差。
#
# 关掉整体功能用 TRIAL_ENABLED=0。
# ⚠️ 把 TRIAL_DAILY_LIMIT 设成 0 是没用的 —— int() 对非正数一律回落到默认值。
TRIAL_ENABLED=1

# 单个 IP 在 24 小时窗口内的次数。
# ⚠️ 必须和**账号自己的上游配额**对齐，而不是按「用户用着爽」来定。
#    OpenRouter 免费档 = 20 请求/分钟 + 50 请求/天（充值满 $10 才升到 1000/天）。
#    一次用户动作 ≠ 一次上游请求：中文检索会多一次查询扩展调用，失败还会重试、
#    换模型。按平均 2~3 次上游调用估，50 次/天大约只够 15~20 次用户动作
#    （**全站合计**）。所以默认值给得很小 —— 它的定位是「让人看到第一道题」。
TRIAL_DAILY_LIMIT=10

# 所有 IP 合计的上限 —— 真正的兜底，护住服务端账号。
# 必须有它：x-forwarded-for / x-real-ip 都是客户端可伪造的请求头，
# 只按 IP 计数的话伪造一下就能拿到无限额度。这个上限不依赖任何客户端输入。
TRIAL_GLOBAL_DAILY_LIMIT=30

# Repository safety limits
MAX_FILE_SIZE_MB=5
MAX_FILES=50000
ANALYSIS_TIMEOUT_SECONDS=900
# 抓取网页时最多读取多少字节（MB）。用户给的 URL 由服务端代抓，
# 不设上限的话一个超大响应就能把进程内存打满（公开部署普遍只有 512MB）。
MAX_HTML_MB=8

# Optional OpenAI-compatible provider credentials (server-side only)
# 可以留空 —— 留空时用户在页面右上角「模型设置」里填自己的 Key 即可使用（BYOK）。
# 配了则所有没带 x-llm-* 请求头的调用都走这份凭据。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 是否允许用户把自定义网关指向内网 / 本机地址。
# 默认禁止（否则本站会变成 SSRF 跳板）。本地开发连 Ollama / LM Studio 时设为 1。
ALLOW_PRIVATE_LLM_BASE_URL=

# ---------- RAG 检索 ----------
# 建索引时最多读入多少字符。有了检索就不必再把整个项目塞进 prompt：
# 全量索引、按需召回。这个上限只是兜住内存。
INDEX_BUDGET_CHARS=600000
# 单个文件送入索引的上限（超长文件按声明边界切块，不会整体丢弃）
MAX_CHARS_PER_FILE_CHARS=20000
# 出题时召回的资料预算 / 回答问题时召回的资料预算（字符）
CONTEXT_BUDGET_CHARS=16000
ANSWER_BUDGET_CHARS=6000
# 单次检索最多返回多少块
MAX_CHUNKS=12
# 是否启用 LLM 查询扩展：中文提问与英文代码没有字面重叠，靠它才能召回。
# 代价是每次中文检索多一次 LLM 调用，额度紧张时设为 0。
RAG_EXPAND_QUERY=1

# ---------- 可选的稠密向量检索 ----------
# 三项齐备才启用，并与 BM25 做 RRF 融合；缺任何一项则纯走 BM25。
# 注意：OpenRouter 的 /embeddings 会返回 403，需要另找支持 embeddings 的网关。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- 前端 ----------
# mock = 使用内置模拟 Agent; http = 调用 /api/agent/*
# 不设则默认 http（真实后端）。⚠️ 编译期内联：构建时没有这个变量就写不进产物。
# 用户一旦在页面上填了自带 Key，即使这里是 mock 也会切到真实后端。
NEXT_PUBLIC_AGENT_MODE=http

# ---------- 开发服务器 ----------
# 关掉 Next 的匿名遥测上报，启动时少一个外网请求。
# 注意：真正会让 `next dev` 卡住的是「版本检查」——webpack 模式下
# HotReloaderWebpack.start() 会 await fetch('https://registry.npmjs.org/...')，
# 没有超时也没有 abort，代理/VPN 把这个域名黑洞时会一直卡到 TCP 超时（约 45 秒），
# 期间浏览器打不开页面。因此 dev 脚本改用 `next dev --turbopack`（不触发该请求）。
NEXT_TELEMETRY_DISABLED=1
